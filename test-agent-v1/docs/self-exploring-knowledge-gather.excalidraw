      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Don't stop at the seed: hypothesize → fan out across three source tiers → ground → promote → crawl → reflect → converge.  Cite every fact; the external LLM is a lead generator, never a source of truth.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Don't stop at the seed: hypothesize → fan out across three source tiers → ground → promote → crawl → reflect → converge.  Cite every fact; the external LLM is a lead generator, never a source of truth.",
      "lineHeight": 1.25
    },
