    },
    {
      "type": "text", "id": "card1b", "x": 206, "y": 200, "width": 270, "height": 85,
      "text": "Two humans score ~30 artifacts\nindependently on the same rubric\n· per-node relevant/irrelevant\n· per-sentence grounded/not",
      "originalText": "Two humans score ~30 artifacts\nindependently on the same rubric\n· per-node relevant/irrelevant\n· per-sentence grounded/not",
