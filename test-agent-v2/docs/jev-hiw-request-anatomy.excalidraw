  {
   "type": "text",
   "id": "tx1259",
   "x": 60,
   "y": 430,
   "width": 1240,
   "height": 17.5,
   "text": "• state — unstructured context (logs / JSON / text), shared by EVERY question in the request.",
   "originalText": "• state — unstructured context (logs / JSON / text), shared by EVERY question in the request.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
