  {
   "type": "text",
   "id": "tx1238",
   "x": 816,
   "y": 137,
   "width": 265.2,
   "height": 178.75,
   "text": "{\n \"route\":   { value:\"infra\",\n   p:{infra:.78, auth:.14,\n      billing:.08},\n   confidence:0.78 },\n \"quality\": { score:0.31,\n   p:{low:.66, med:.28, high:.06},\n   confidence:0.71 },\n \"urgent\":  { noul:0.93 }\n   // P(true) in 0..1\n}",
   "originalText": "{\n \"route\":   { value:\"infra\",\n   p:{infra:.78, auth:.14,\n      billing:.08},\n   confidence:0.78 },\n \"quality\": { score:0.31,\n   p:{low:.66, med:.28, high:.06},\n   confidence:0.71 },\n \"urgent\":  { noul:0.93 }\n   // P(true) in 0..1\n}",
