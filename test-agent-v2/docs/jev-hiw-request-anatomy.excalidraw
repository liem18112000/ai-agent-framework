  {
   "type": "text",
   "id": "tx1301",
   "x": 60,
   "y": 500,
   "width": 1240,
   "height": 35.0,
   "text": "• per-question out — a typed value + the FULL probability distribution + a calibrated confidence. Code branches / sorts / routes directly — no text\nparsing, no schema-repair retry.",
   "originalText": "• per-question out — a typed value + the FULL probability distribution + a calibrated confidence. Code branches / sorts / routes directly — no text\nparsing, no schema-repair retry.",
