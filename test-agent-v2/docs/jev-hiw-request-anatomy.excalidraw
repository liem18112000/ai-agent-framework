  {
   "type": "text",
   "id": "tx1280",
   "x": 60,
   "y": 458,
   "width": 1240,
   "height": 17.5,
   "text": "• questions — a LIST (map) of N typed questions; the answer set / schema is fixed up front, so the shape of the reply is known before the call.",
   "originalText": "• questions — a LIST (map) of N typed questions; the answer set / schema is fixed up front, so the shape of the reply is known before the call.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
