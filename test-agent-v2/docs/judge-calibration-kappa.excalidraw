      "id": "note2_title",
      "x": 1230, "y": 578, "width": 350, "height": 22,
      "text": "Canary seeds guard drift",
      "originalText": "Canary seeds guard drift",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#b45309", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
