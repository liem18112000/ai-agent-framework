    },
    {
      "type": "text",
      "id": "note1_body",
      "x": 1230, "y": 410, "width": 355, "height": 100,
      "text": "Pin judge_model_id(). A κ measured\non one model version doesn't\ntransfer — re-calibrate on any\nmodel or prompt change.",
      "originalText": "Pin judge_model_id(). A κ measured\non one model version doesn't\ntransfer — re-calibrate on any\nmodel or prompt change.",
