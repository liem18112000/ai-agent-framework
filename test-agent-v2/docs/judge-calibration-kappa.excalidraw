    },
    {
      "type": "text",
      "id": "note2_body",
      "x": 1230, "y": 610, "width": 355, "height": 100,
      "text": "Between recalibrations, canary\nseeds catch DRIFT — a\ndeliberately-bad artifact must\nalways score low (golden/canary/).",
      "originalText": "Between recalibrations, canary\nseeds catch DRIFT — a\ndeliberately-bad artifact must\nalways score low (golden/canary/).",
