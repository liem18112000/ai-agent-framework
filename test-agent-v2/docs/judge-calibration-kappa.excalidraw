    {
      "type": "text",
      "id": "formula_txt",
      "x": 1230, "y": 212, "width": 350, "height": 26,
      "text": "κ = (p_o − p_e) / (1 − p_e)",
      "originalText": "κ = (p_o − p_e) / (1 − p_e)",
      "fontSize": 20, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 190005, "version": 1,
      "versionNonce": 190006, "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "formula_sub",
      "x": 1230, "y": 252, "width": 350, "height": 40,
      "text": "p_o = observed agreement ·\np_e = agreement by chance",
      "originalText": "p_o = observed agreement ·\np_e = agreement by chance",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#cbd5e1", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 190007, "version": 1,
      "versionNonce": 190008, "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.4
    },

