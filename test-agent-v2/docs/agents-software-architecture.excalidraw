   "id": "mem_l3",
   "text": "READ (flag-gated):   common/memory/retrieve.py facade · MEMORY_BACKEND = gcs → hybrid → postgres    ( default gcs = byte-for-byte today ;  hybrid = vector ∪ full-text ∪ SQL, then B4 hub-penalty + B5 grounding )",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "READ (flag-gated):   common/memory/retrieve.py facade · MEMORY_BACKEND = gcs → hybrid → postgres    ( default gcs = byte-for-byte today ;  hybrid = vector ∪ full-text ∪ SQL, then B4 hub-penalty + B5 grounding )",
   "lineHeight": 1.25,
   "baseline": 12
