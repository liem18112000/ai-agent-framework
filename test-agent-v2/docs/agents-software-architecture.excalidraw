   "id": "mem_l1",
   "text": "WRITE (GCS = truth, unchanged):   notes / insights → GCS   →   ② project (async, off request path)   →   Cloud SQL + pgvector recall   (reuses the task-store instance / shared common/db.py engine)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WRITE (GCS = truth, unchanged):   notes / insights → GCS   →   ② project (async, off request path)   →   Cloud SQL + pgvector recall   (reuses the task-store instance / shared common/db.py engine)",
