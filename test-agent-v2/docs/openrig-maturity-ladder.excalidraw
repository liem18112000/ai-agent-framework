   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "THE WARRANT RULE\n\nA promoted claim carries its compressed warrant \u2014\nthe scar, evidence or ruling that earned it\ntravels with it.\n\n\"Canon without warrants is cargo cult with good\nformatting.\"",
   "originalText": "THE WARRANT RULE\n\nA promoted claim carries its compressed warrant \u2014\nthe scar, evidence or ruling that earned it\ntravels with it.\n\n\"Canon without warrants is cargo cult with good\nformatting.\"",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": false
  },
