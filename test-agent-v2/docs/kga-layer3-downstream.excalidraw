    {
      "type": "text",
      "id": "text_1721",
      "x": 104,
      "y": 404,
      "width": 466,
      "height": 60,
      "angle": 0,
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1728,
      "version": 1,
      "versionNonce": 1735,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "# metrics/noise.py\nleaked = [t for t in injected_terms\n          if t in perturbed and t not in baseline]\nnoise_sensitivity = len(leaked)/len(injected_terms)",
      "originalText": "# metrics/noise.py\nleaked = [t for t in injected_terms\n          if t in perturbed and t not in baseline]\nnoise_sensitivity = len(leaked)/len(injected_terms)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "containerId": null
    },
    {
      "type": "text",
      "id": "text_1742",
      "x": 600,
      "y": 402,
      "width": 877,
      "height": 35,
      "angle": 0,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1749,
      "version": 1,
      "versionNonce": 1756,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "0.0 = noise ignored (good);  >0 = the injected node's terms leaked into the understanding — the bleed,\nat the output level.  Causal, not correlational: toggle a de-bias knob and watch the terms stop leaking.",
      "originalText": "0.0 = noise ignored (good);  >0 = the injected node's terms leaked into the understanding — the bleed,\nat the output level.  Causal, not correlational: toggle a de-bias knob and watch the terms stop leaking.",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "containerId": null
    },
    {
      "type": "text",
      "id": "text_1763",
      "x": 600,
      "y": 452,
      "width": 511,
      "height": 32,
      "angle": 0,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1770,
      "version": 1,
      "versionNonce": 1777,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Precision (Layer 1) catches the junk node being RETRIEVED;\nnoise sensitivity catches whether it actually CHANGED the answer.",
      "originalText": "Precision (Layer 1) catches the junk node being RETRIEVED;\nnoise sensitivity catches whether it actually CHANGED the answer.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "containerId": null
    },
