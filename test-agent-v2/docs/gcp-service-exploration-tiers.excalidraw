    {
      "type": "text",
      "id": "ct1131",
      "x": 1166,
      "y": 386,
      "width": 458,
      "height": 148,
      "text": "# envs.py  — one config map = 'all envs'\nENV_MATRIX = {\n  'dev':         Env('klara-nonprod','ew6','dev'),\n  'dev-staging': Env('klara-nonprod','ew6','staging'),\n  'performance': Env('klara-nonprod','ew6','perf'),\n  'test':        Env('klara-nonprod','ew6','test'),\n  'prod':        Env('klara-prod',   'ew6','prod'),\n}  # KGA_GCP_ENV_MATRIX overrides as JSON",
      "originalText": "# envs.py  — one config map = 'all envs'\nENV_MATRIX = {\n  'dev':         Env('klara-nonprod','ew6','dev'),\n  'dev-staging': Env('klara-nonprod','ew6','staging'),\n  'performance': Env('klara-nonprod','ew6','perf'),\n  'test':        Env('klara-nonprod','ew6','test'),\n  'prod':        Env('klara-prod',   'ew6','prod'),\n}  # KGA_GCP_ENV_MATRIX overrides as JSON",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
