   "roundness": null,
   "seed": 100065,
   "version": 1,
   "versionNonce": 100066,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ADK's own default also marks the LAST message \u2014 right for a growing chat, wrong here. Our generators\nare single-turn leaves whose last message is the per-batch user prompt, different every call.\nMarking it would write a fresh entry per batch and never read one: strictly overhead.",
   "originalText": "ADK's own default also marks the LAST message \u2014 right for a growing chat, wrong here. Our generators\nare single-turn leaves whose last message is the per-batch user prompt, different every call.\nMarking it would write a fresh entry per batch and never read one: strictly overhead.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 14
  }
 ],
