      "locked": false,
      "fontSize": 12.5,
      "fontFamily": 3,
      "text": "WITH vec AS (\n  SELECT id, 1-(embedding <=> $q) AS vs FROM memory_node\n  WHERE status='active' AND scope=ANY($scopes)\n  ORDER BY embedding <=> $q LIMIT 40 ),\nlex AS (\n  SELECT id, ts_rank(tsv,plainto_tsquery($t)) AS ls\n  FROM memory_node WHERE tsv @@ plainto_tsquery($t) )\nSELECT id FROM vec FULL OUTER JOIN lex USING(id)\nORDER BY  /* RRF( vs, ls ) */  LIMIT 10;",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WITH vec AS (\n  SELECT id, 1-(embedding <=> $q) AS vs FROM memory_node\n  WHERE status='active' AND scope=ANY($scopes)\n  ORDER BY embedding <=> $q LIMIT 40 ),\nlex AS (\n  SELECT id, ts_rank(tsv,plainto_tsquery($t)) AS ls\n  FROM memory_node WHERE tsv @@ plainto_tsquery($t) )\nSELECT id FROM vec FULL OUTER JOIN lex USING(id)\nORDER BY  /* RRF( vs, ls ) */  LIMIT 10;",
      "lineHeight": 1.25
    },
