   "versionNonce": 1336,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "THE INVERSION \u2014 openrig's refocus ASKS the agent whether it has drifted (\"discomfort is the signal\"), because that harness owns no\njudge. We own JEV: a bare noul float = P(true), already fronting failure triage and the gather source gate, already \u03ba-calibrated. We\ncan MEASURE drift instead of asking about it.",
   "originalText": "THE INVERSION \u2014 openrig's refocus ASKS the agent whether it has drifted (\"discomfort is the signal\"), because that harness owns no\njudge. We own JEV: a bare noul float = P(true), already fronting failure triage and the gather source gate, already \u03ba-calibrated. We\ncan MEASURE drift instead of asking about it.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": false
