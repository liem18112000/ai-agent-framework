# Full local-parity stack env — copy to .env.compose, fill Atlassian + bearers, `docker compose up --build`.
# Loaded into every app service. .env.compose is gitignored — never commit real secrets.

# === Object store: MinIO (S3) ==============================================
STORE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=testagent-memory
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
GCS_BUCKET=testagent-local          # dummy — presence satisfies /readyz; never dialed under STORE_BACKEND=s3

# === Postgres (pgvector) — A2A task store + ADK sessions + hybrid recall ====
DB_USER=taagent
DB_PASSWORD=taagent
DB_NAME=testagent
TASK_DB_URL=postgresql+asyncpg://taagent:taagent@db:5432/testagent

# === Redis (benchmark cache) ===============================================
CACHE_BACKEND=redis
REDIS_HOST=redis
REDIS_PORT=6379

# === Memory: hybrid semantic recall (pgvector + local Ollama embeddings) ====
MEMORY_BACKEND=hybrid
VECTOR_BACKEND=pgvector
EMBED_BACKEND=ollama
OLLAMA_URL=http://ollama:11434
MEMORY_EMBED_MODEL=nomic-embed-text
MEMORY_EMBED_DIMS=768

# === LLM: LOCAL CLAUDE SUBSCRIPTION via the claude-proxy sidecar =============
# The agents call your `claude` CLI (subscription) through claude-proxy. Log in ONCE (persists in a volume):
#   docker compose exec claude-proxy claude      # then /login, or: claude setup-token
# NON-LOCAL (deployed) must DISABLE this — comment the 3 LITELLM_* lines and pick a normal backend:
#   Ollama (offline) → LITELLM_MODEL=ollama/llama3.2  LITELLM_API_BASE=http://ollama:11434
#   Anthropic API    → LITELLM_MODEL=anthropic/claude-sonnet-5  LITELLM_API_KEY=sk-ant-...
#   Vertex           → TESTAGENT_MODEL_BACKEND=claude  + VERTEX_*
TESTAGENT_MODEL_BACKEND=litellm
LITELLM_MODEL=openai/claude-local    # served by claude-proxy (your subscription; not a real OpenAI call)
LITELLM_API_BASE=http://claude-proxy:8088/v1
LITELLM_API_KEY=local                # dummy — the proxy authenticates via the subscription, not this key
TESTAGENT_DEFAULT_MAX_TOKENS=6000
TESTAGENT_TURBO=1                    # fewer LLM gates — important: each claude-proxy call spins up the CLI (slow)
# CLAUDE_MODEL=claude-sonnet-4-5     # optional: pin which model `claude -p` uses
# OLLAMA_CHAT_MODEL=llama3.2         # ONLY set this to use Ollama as the LLM (offline fallback) — then ollama-init pulls it.
                                     # Left unset by default → no 2GB chat pull; Ollama serves EMBEDDINGS only (below).

# === Queue: distributed scenario generation via Redis Streams (Phase C) =====
TPD_GEN_MODE=workers
TPD_QUEUE_BACKEND=redis              # redis (local, reuses the Redis above) | pubsub (prod)
TPD_WORKER_TOPIC=tpd-gen-batches     # the Redis Stream name
TPD_WORKER_GROUP=tpd-gen-workers     # the consumer group

# === Decisions: JEV cloud API (typesafe-sdk) — remote, no local compute/disk =
# The laya local sidecar was dropped (torch doesn't fit a low-disk CPU box). JEV runs in the cloud.
TPD_DECISION_BACKEND=jev
TYPESAFE_API_KEY=                    # your JEV/typesafe API key; BLANK → decisions fall back to the LLM
# TYPESAFE_DEFAULT_CONFIDENCE=1.0    # confidence used when JEV omits one
# TPD_DECISION_CONF_MIN=0.8         # cascade trust floor
# TEV_NOUL_THRESHOLD=0.5            # semantic-judge accept cut P(true)>=x

# === Auth: DISABLED for local dev ==========================================
# Fail-closed bearer gate (common/adk/auth.py); blank token + ALLOW_INSECURE=1 opens it.
# ALLOW_INSECURE is local-ONLY — never set it in a deployed/public env.
# KEEP THE TOKEN LINES COMMENT-FREE: an inline `# ...` on a BLANK value leaks into the value
# (compose only strips inline comments that follow a non-empty value).
ALLOW_INSECURE=1
A2A_BEARER_TOKEN=
GATEWAY_BEARER_TOKEN=

# === Atlassian (KGA crawler) — needed for a real gather =====================
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-atlassian-token
# ATLASSIAN_BITBUCKET_USERNAME=you@example.com
# ATLASSIAN_BITBUCKET_APP_PASSWORD=your-bitbucket-app-password

# === Self-learning (optional) ==============================================
# KGA_CAPTURE_LESSONS=1
# TPD_RECALL_LESSONS=1
