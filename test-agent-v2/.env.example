# test-agent-v2 — example environment (copy to .env; never commit real secrets)

# --- ADK model backend (C1, common/adk/config.py + providers/) ---
TESTAGENT_MODEL_BACKEND=claude          # a key in common/adk/providers._REGISTRY (default: claude)
TESTAGENT_DEFAULT_MAX_TOKENS=6000

# --- Vertex (the VertexClaudeProvider resolves project/location/model here) ---
VERTEX_PROJECT=my-gcp-project
VERTEX_LOCATION=global                  # Claude on Vertex (claude-sonnet-5) is served in 'global'
VERTEX_MODEL=claude-sonnet-5

# --- Memory bank + recall tier ---
GCS_BUCKET=my-agent-memory-bucket
MEMORY_BACKEND=gcs                      # gcs | hybrid (Cloud SQL + pgvector)
# MEMORY_EMBED_LOCATION=us-central1

# --- Atlassian (KGA crawler) ---
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=<redacted>
# ATLASSIAN_BITBUCKET_USERNAME=you@example.com
# ATLASSIAN_BITBUCKET_APP_PASSWORD=<redacted>

# --- A2A + gateway bearer tokens ---
# Required by deployments/test-agent-v2/deploy.sh (pushes them as Secret Manager versions) and by
# install-mcp.{sh,cmd}. Generate each: `openssl rand -hex 32`. Use FRESH values for v2.
# A2A_BEARER_TOKEN=<redacted>       # gateway -> agents (the shared A2A bearer the agents enforce)
# GATEWAY_BEARER_TOKEN=<redacted>   # Claude -> gateway (the single MCP endpoint's inbound gate)

# --- Self-learning (default OFF) ---
# KGA_CAPTURE_LESSONS=1
# TPD_RECALL_LESSONS=1

# --- Cloud service exploration, KGA tiers 5/6/7 (CloudProvider port — GCP adapter today; Azure/AWS future) ---
# NO on/off flag: the tiers turn ON exactly when a provider's env map is configured (below). Unset → off.
# Neutral knobs:
# KGA_CLOUD_PROVIDERS=gcp                 # comma-separated adapters to query (default: gcp)
# KGA_CLOUD_MAX_SERVICES=8               # cap on promoted cloudsvc: seeds
# KGA_CLOUD_WINDOWS=7,14,21,28           # expanding log-read window (days)
# Provider-scoped env→coordinates map (GCP adapter; needs the `gcp` pyproject extra). Configuring THIS
# is what enables the tiers. Fields per env: project, region (required), cluster, namespace (optional).
# Primary = inline JSON; OR point KGA_GCP_ENV_MATRIX_FILE at a mounted JSON file (better for big maps):
# KGA_GCP_ENV_MATRIX={"dev":{"project":"klara-nonprod","region":"europe-west6","cluster":"klara-nonprod","namespace":"dev"},"prod":{"project":"klara-prod","region":"europe-west6","cluster":"klara-prod","namespace":"prod"}}
# KGA_GCP_ENV_MATRIX_FILE=/etc/kga/gcp-env-matrix.json   # see deployments/gcp-env-matrix.example.json

# --- JEV DecisionProvider (System-1 cascade; default OFF, additive) ---
# Needs: the `jev` extra installed + both vars below. providers/jev.py wraps the typesafe-sdk.
# TPD_DECISION_BACKEND=jev
# TYPESAFE_API_KEY=
# Optional knobs: cascade trust floor (default 0.8), the confidence used when JEV omits one, and the
# TEV semantic-judge noul accept cut P(true)>=x (default 0.5).
# TPD_DECISION_CONF_MIN=0.8
# TYPESAFE_DEFAULT_CONFIDENCE=1.0
# TEV_NOUL_THRESHOLD=0.5
