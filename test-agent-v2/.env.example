# test-agent-v2 — example environment (copy to .env; never commit real secrets)

# --- ADK model backend (E2, common/adk/config.py) ---
TESTAGENT_MODEL_BACKEND=claude          # claude (LiteLlm, default) | gemini (native)
TESTAGENT_GEMINI_MODEL=gemini-2.5-flash
TESTAGENT_DEFAULT_MAX_TOKENS=6000

# --- Vertex (Claude-via-LiteLlm path resolves project/location/model here) ---
VERTEX_PROJECT=my-gcp-project
VERTEX_LOCATION=europe-west6
VERTEX_MODEL=claude-sonnet-5
GOOGLE_GENAI_USE_VERTEXAI=1             # for the Gemini-native path / adk web

# --- Memory bank + recall tier ---
GCS_BUCKET=my-agent-memory-bucket
MEMORY_BACKEND=gcs                      # gcs | hybrid (Cloud SQL + pgvector)
# MEMORY_EMBED_LOCATION=us-central1

# --- Atlassian (KGA crawler) ---
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=<redacted>
# ATLASSIAN_BITBUCKET_USERNAME=you@example.com
# ATLASSIAN_BITBUCKET_APP_PASSWORD=<redacted>

# --- A2A bearer (agent) ---
# A2A_BEARER_TOKEN=<redacted>

# --- Self-learning (default OFF) ---
# KGA_CAPTURE_LESSONS=1
# TPD_RECALL_LESSONS=1
