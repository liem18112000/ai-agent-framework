# Real values for the v2 (ADK) stack. GITIGNORED — never committed. NO secrets live here:
#   - the Cloud SQL DB password is generated by terraform (random_password → Secret Manager);
#   - Atlassian API token + A2A/bridge bearer tokens are added by ./deploy.sh from
#     ../../test-agent-v2/.env (ATLASSIAN_API_TOKEN, A2A_BEARER_TOKEN, KGA/TPD_BRIDGE_BEARER_TOKEN).
# This file is only non-secret config.
#
# Separate, coexisting from test-agent-v1: …-v2 service names, name_prefix "kga-v2", its own bucket
# (<project>-kga-v2-memory) and its own terraform state. v1 is left untouched.
#
# NOTE: db_instance_name + artifact_repo default to "kga-taskstore" / "kga" — the SAME names v1 uses.
# Since v1 + v2 share the klara-nonprod project, they MUST be given distinct -v2 names here or the
# apply 409s on v1's live Cloud SQL instance + artifact repo. (They are not covered by name_prefix.)

project_id    = "klara-nonprod"
region        = "europe-west6"
vertex_region = "global" # Claude on Vertex (claude-sonnet-5) is served in 'global'
vertex_model  = "claude-sonnet-5"

# Isolate from v1 (these two are NOT -v2-prefixed by default):
db_instance_name = "kga-v2-taskstore"
artifact_repo    = "kga-v2"

atlassian_base_url = "https://axonivy.atlassian.net"
atlassian_email    = "liem.doanvanthanh@axonactive.com"

# Warm one instance for lower first-call latency.
min_instances = 1

# The inbound bearer is the gate; keep the bridge publicly reachable so Claude Code can register with it.
bridge_allow_unauthenticated = true

# v2 provisions its OWN Cloud SQL Postgres instance (durable DatabaseSessionService), isolated from v1.
# The DB password is terraform-generated → Secret Manager (nothing to supply). Set false for in-memory.
deploy_cloudsql = true

# LLM-authored test-data / steps at implement (richer, slower — extra Vertex calls; 600s timeouts cover it).
tpd_llm_detail = true

# The containers override the entrypoint to run uvicorn, so the hello placeholder can't start — the
# real image must exist BEFORE the services are created. Pinned to the current HEAD; build+push to the
# kga-v2 repo, then apply. (europe-west6-docker.pkg.dev/<project>/<artifact_repo>/test-agent-v2:<tag>)
image = "europe-west6-docker.pkg.dev/klara-nonprod/kga-v2/test-agent-v2:2db8605-slugfix"

# Bump agent memory: 512Mi OOMs during gather (crawl + ADK + always-on Vertex planners).
memory = "2Gi"
