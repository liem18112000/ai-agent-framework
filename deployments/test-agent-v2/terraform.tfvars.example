# Copy to terraform.tfvars and fill in. Do NOT put secret values here.
#
# This is the v2 (ADK) stack — a SEPARATE, coexisting deployment from test-agent-v1:
# distinct service names (…-v2), its own secrets/SA (name_prefix "kga-v2") and memory bucket
# (<project>-kga-v2-memory), and its own terraform state. v1 is untouched.
project_id         = "my-gcp-project"
region             = "europe-west6"
vertex_region      = "global" # Claude on Vertex (claude-sonnet-5) is served in 'global'
vertex_model       = "claude-sonnet-5"

atlassian_base_url = "https://axonivy.atlassian.net"
atlassian_email    = "liem.doanvanthanh@axonactive.com"

# The v2 image (built by ./build-image.sh / ./deploy.sh from ../../test-agent-v2):
# image = "europe-west6-docker.pkg.dev/klara-repo/artifact-registry-container-images/test-agent-v2:latest"

# Optional overrides:
# bucket_name          = "my-gcp-project-kga-v2-memory"
# min_instances        = 1        # warm for lower first-call latency
# bridge_allow_unauthenticated = true    # public ingress; the A2A bearer is then the only gate
#
# Durable sessions: v2 provisions its OWN Cloud SQL Postgres instance by default
# (deploy_cloudsql = true → DatabaseSessionService). The DB password is generated by
# Terraform (random_password) and stored in Secret Manager — no secret to supply here.
# Set false for in-memory sessions (the GCS bank stays durable regardless).
# deploy_cloudsql      = false    # opt OUT of the dedicated instance
#
# Cloud exploration tiers 5/6/7 (KGA discover/logs/relate). OFF by default. To enable:
#   1) set gcp_env_matrix to your env->infra map (config presence is the toggle — no separate flag),
#   2) list the projects the agent may READ in cloud_exploration_projects (grants read-only viewer roles),
#   3) the deployed image already installs the [gcp] extra.
# The example map lives in ./gcp-env-matrix.example.json — inline it as one JSON string here:
# gcp_env_matrix = "{\"dev\":{\"project\":\"klara-nonprod\",\"region\":\"europe-west6\",\"cluster\":\"klara-nonprod\",\"namespace\":\"dev\"},\"prod\":{\"project\":\"klara-prod\",\"region\":\"europe-west6\",\"cluster\":\"klara-prod\",\"namespace\":\"prod\"}}"
# cloud_exploration_projects = ["klara-nonprod"]           # add "klara-prod" only after approving cross-project read
